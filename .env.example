# Copy this file to ".env" and fill in real values. .env is git-ignored.

# --- ActiveCampaign (Step 0) ---
# Account id is the number in your AC URL (https://2116665.activehosted.com) -> 2116665
AC_ACCOUNT=2116665
# Settings -> Developer -> API Access -> Key
AC_API_TOKEN=

# --- GA4 (Step 2) ---
# GA4 Admin -> Property Settings -> Property ID (numeric, NOT the "G-XXXX" measurement id)
GA4_PROPERTY_ID=
# Path to the downloaded service-account key
GA4_SA_JSON=secrets/ga4-service-account.json

# --- Google Ads (Step 3) ---
# Used by scripts/google_ads_auth.py to mint a refresh token
GADS_OAUTH_CLIENT_JSON=secrets/oauth_client.json
# Final config consumed by scripts/google_ads_pull.py
GADS_YAML=secrets/google-ads.yaml
# The account to query (digits only, no dashes). If under an MCC, set GADS_LOGIN_CUSTOMER_ID to the MCC id.
GADS_CUSTOMER_ID=
GADS_LOGIN_CUSTOMER_ID=
